---
import Footer from '@/components/Footer';
import { projectsData } from '@/data/projects';
import Layout from '@/layouts/Layout.astro';

export function getStaticPaths() {
	return projectsData.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} | hrtk92.dev`}
  description={project.description}
  type="article"
>
  <div class="w-full max-w-4xl py-12 flex flex-col gap-12">
    <!-- Back Button -->
    <div>
      <button
        onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/#projects'; }"
        class="cursor-pointer inline-flex items-center gap-2 rounded-full border border-slate-200/80 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 px-4 py-2 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 backdrop-blur-md transition-all hover:bg-white dark:hover:bg-slate-800 hover:scale-105 active:scale-95 shadow-xs"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6" />
        </svg>
        <span>Back to Projects</span>
      </button>
    </div>

    <!-- Main Project Card (Morphed from list) -->
    <div
      style={`view-transition-name: card-${project.slug};`}
      class="flex flex-col gap-8 rounded-[2.5rem] border border-slate-200/80 dark:border-white/10 bg-white/60 dark:bg-slate-900/70 p-8 sm:p-12 shadow-[0_12px_40px_rgba(0,0,0,0.04)] dark:shadow-[0_12px_40px_rgba(0,0,0,0.4)] backdrop-blur-2xl"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-b border-slate-200/60 dark:border-white/10 pb-8">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-blue-500 dark:text-blue-400">
            Project Overview
          </span>
          <h1
            style={`view-transition-name: title-${project.slug};`}
            class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white"
          >
            {project.title}
          </h1>
        </div>

        <div class="flex items-center gap-3">
          {project.links.github && (
            <a
              href={project.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-10 items-center gap-2 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-5 text-xs sm:text-sm font-semibold shadow-sm transition-all hover:scale-105 active:scale-95"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>View Source</span>
            </a>
          )}
        </div>
      </div>

      <!-- Tech Stack Tags -->
      <div
        style={`view-transition-name: tags-${project.slug};`}
        class="flex flex-wrap gap-2"
      >
        {project.tags.map((tag) => (
          <span class="rounded-xl border border-slate-200/80 dark:border-white/10 bg-white/70 dark:bg-white/5 px-3 py-1.5 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 backdrop-blur-md">
            {tag}
          </span>
        ))}
      </div>

      <!-- Description Body -->
      <div class="space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
          About this project
        </h2>
        <p
          style={`view-transition-name: desc-${project.slug};`}
          class="text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300"
        >
          {project.longDescription || project.description}
        </p>
      </div>

      <!-- Key Features (Bento Style) -->
      {project.features && (
        <div class="space-y-4 pt-4 border-t border-slate-200/60 dark:border-white/10">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
            Key Features & Solutions
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            {project.features.map((feat) => (
              <div class="flex items-start gap-3 rounded-2xl border border-slate-200/60 dark:border-white/5 bg-white/40 dark:bg-white/5 p-4 backdrop-blur-xs">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-500/10 text-blue-500 font-bold text-xs">
                  ✓
                </span>
                <span class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-normal">
                  {feat}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Architecture Highlights -->
      {project.architecture && (
        <div class="space-y-4 pt-4 border-t border-slate-200/60 dark:border-white/10">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
            Tech Architecture
          </h2>
          <ul class="flex flex-col gap-2.5">
            {project.architecture.map((item) => (
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-mono">
                <span class="text-purple-500 font-bold">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <Footer client:idle />
  </div>
</Layout>
