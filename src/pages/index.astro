---
import Footer from '@/components/Footer';
import HeroAndAbout from '@/components/HeroAndAbout';
import Projects from '@/components/Projects';
import Skills from '@/components/Skills';
import Layout from '../layouts/Layout.astro';
---

<Layout title='hrtk92.dev | Portfolio' description='hrtk92のポートフォリオサイトです。'>
  <div class='flex w-full flex-col items-center gap-20 sm:gap-28'>
    <HeroAndAbout client:load />

    <Skills client:visible={{ rootMargin: '200px' }} />

    <Projects client:load />

    <Footer client:idle />
  </div>
</Layout>
